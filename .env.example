# ============================================================
# MEDIASTORE — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs
# ============================================================

# === URL DE L'APPLICATION ===
# En production : https://votre-domaine.com
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================================
# NOTCHPAY — Orange Money CM & MTN MoMo CM
# Inscription : https://notchpay.co
# Dashboard   : https://business.notchpay.co
# ============================================================
NOTCHPAY_PUBLIC_KEY=pk_live_...
NOTCHPAY_PRIVATE_KEY=sk_live_...

# ============================================================
# CINETPAY — Wave, Orange, MTN, Moov, Airtel (14 pays africains)
# Inscription : https://cinetpay.com
# Dashboard   : https://app.cinetpay.com
# ============================================================
CINETPAY_API_KEY=votre_api_key_cinetpay
CINETPAY_SITE_ID=votre_site_id_cinetpay

# ============================================================
# STRIPE — Carte Bancaire (Visa/Mastercard) + PayPal
# Inscription : https://stripe.com
# Dashboard   : https://dashboard.stripe.com
# ============================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Pour tester en local avec Stripe CLI :
# stripe listen --forward-to localhost:3000/api/webhooks/stripe

# ============================================================
# NEXTAUTH (authentification avancée — future)
# ============================================================
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=une-chaine-secrete-aleatoire-longue

# ============================================================
# BASE DE DONNÉES (future — pour persister les commandes)
# ============================================================
DATABASE_URL=postgresql://user:password@localhost:5432/mediastore

# ============================================================
# SMART CRM — Supabase partagé (contacts Google + relances)
# Même base que Smart Book, Smart Voice, etc.
# La clé est dans /etc/relais.env sur le VPS (SUPABASE_SERVICE_KEY)
# ============================================================
SMART_SUPABASE_URL=https://rzaepmvnkzmrhgdesssv.supabase.co
SMART_SUPABASE_SERVICE_KEY=eyJ...votre_cle_de_service

# ============================================================
# ADMIN
# ============================================================
# ADMIN_PASSWORD=VotreMotDePasseSecurise
